# Local dev secrets (never committed — .dev.vars is gitignored).
# Copy this file to `.dev.vars` (wrangler reads .dev.vars in `npm run dev`),
# then fill in real values. Generate a throwaway Ed25519 keypair for
# LICENSE_PRIVATE_KEY / LICENSE_PUBLIC_KEY (and an ADMIN_API_KEY); use Stripe
# TEST keys and a Resend key while developing.
#
#   % node scripts/generate-keys.mjs     # prints both halves + a wrangler cmd
#
# Run `npm run dev`, then:
#   curl -X POST http://localhost:8787/mint \
#     -H "Authorization: Bearer dev-admin" \
#     -d '{"email":"buyer@example.com"}'

LICENSE_PRIVATE_KEY=change-me-base64-pkcs8-ed25519-private-key
# LICENSE_PUBLIC_KEY is an Ed25519 JWK as a single-line JSON string
# (the public half of the same pair; safe to expose, served at /public-key).
LICENSE_PUBLIC_KEY={"kty":"OKP","crv":"Ed25519","x":"<base64url>","alg":"EdDSA"}
ADMIN_API_KEY=dev-admin-key
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
