{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "lib": ["ES2022", "WebWorker"],
        "strict": true,
        "noEmit": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "types": ["@cloudflare/workers-types", "node"]
    },
    "include": ["src", "test"]
}
